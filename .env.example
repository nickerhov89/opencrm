PORT=3001
HOST=127.0.0.1
# PostgreSQL connection. Without it the app uses embedded PGlite (tests and demo only).
# DATABASE_URL=postgresql://opencrm:password@127.0.0.1:5432/opencrm
# Keep embedded PGlite data on disk instead of in memory (development only).
# PGLITE_DIR=./data/pglite
# Password of the postgres container in compose.yaml (letters and digits only).
POSTGRES_PASSWORD=change-me-to-a-long-random-hex-string
UPLOAD_DIR=./data/uploads
OPENCRM_PORT=3001
COOKIE_SECURE=0
# Attachment storage limits in megabytes (total and per employee).
# ATTACHMENT_QUOTA_MB=10240
# ATTACHMENT_USER_QUOTA_MB=2048
# Maximum rows in one CSV import.
# IMPORT_MAX_ROWS=5000
# Longest single database query in milliseconds (0 = no limit); a slow request gets 503 instead of hanging the CRM.
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# Public lead forms: accepted submissions from one address (IPv4, or an IPv6 /64) per window, across all forms.
# PUBLIC_FORM_LIMIT=5
# PUBLIC_FORM_WINDOW_MINUTES=10
# Days to keep the security log (minimum 30).
# AUDIT_LOG_RETENTION_DAYS=365
# Optional exact hostname allowlist for internal webhook destinations (comma-separated).
# OPENCRM_WEBHOOK_ALLOWED_HOSTS=n8n.internal,127.0.0.1
# Backup service in compose.yaml: daily time and time zone (default 00:00 Moscow time);
# with an empty BACKUP_AT a copy is made every BACKUP_INTERVAL_HOURS instead.
# BACKUP_AT=00:00
# BACKUP_TZ=Europe/Moscow
# BACKUP_INTERVAL_HOURS=24
# Local copies to keep; 0 = keep none on this host, only in S3 (requires BACKUP_S3_*).
# BACKUP_KEEP=14
# Off-site copies to S3-compatible storage (empty bucket = off). See README.ru.md, «Резервная копия».
# BACKUP_S3_ENDPOINT=https://storage.yandexcloud.net
# BACKUP_S3_REGION=ru-central1
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=opencrm
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_KEEP_DAYS=30
# BACKUP_S3_ENCRYPTION_PASSWORD=
# Mail (docs/MAIL.md): key that encrypts mailbox passwords; without it a random key is kept in
# <data>/secret.key next to the uploads. Keep it out of backups and do not change it.
# OPENCRM_SECRET_KEY=

# Plugins (docs/PLUGINS.md): their folder, by default next to UPLOAD_DIR; 0 turns off uploads in Settings → Plugins.
# PLUGINS_DIR=./data/plugins
# OPENCRM_PLUGIN_UPLOAD=1
# OPENCRM_MAIL_SYNC_SECONDS=120
# Mail sending: at most this many addresses in one letter (To + Cc) and letters per employee an hour.
# MAIL_MAX_RECIPIENTS=10
# MAIL_SEND_PER_HOUR=50
# Log SQL queries slower than this many milliseconds.
# OPENCRM_SLOW_SQL_MS=500

# amoCRM ⇄ OpenCRM sync while both CRMs run (docs/AMOCRM_SYNC.md). Uses AMO_BASE_URL, AMO_ACCESS_TOKEN,
# AMO_PROXY_URL and AMO_RPS. off | dry_run (only the log) | amo_to_opencrm | both (also OpenCRM → amoCRM).
AMOCRM_SYNC_MODE=off
# Mode both: writing to amoCRM is dry_run (only the log of the requests it would send) or on.
AMOCRM_SYNC_TO_AMO=dry_run
# Records made in OpenCRM have numbers from here (deals, contacts, companies, tasks / notes).
AMOCRM_SYNC_NATIVE_FROM=50000001
AMOCRM_SYNC_NATIVE_NOTES_FROM=500000001
# Whose value wins when a field changed in both CRMs: amo | opencrm.
AMOCRM_SYNC_PRIMARY=amo
# Where the first run starts reading amoCRM changes, e.g. when the export of the last load began.
AMOCRM_SYNC_SINCE=
AMOCRM_SYNC_INTERVAL_SEC=60
AMOCRM_SYNC_OVERLAP_SEC=120
# Owner for records whose amoCRM employee has no account here (empty: no owner).
AMOCRM_SYNC_DEFAULT_OWNER_ID=
